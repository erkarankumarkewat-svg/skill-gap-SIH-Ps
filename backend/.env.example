# ==============================================================================
# SkillTrack India - Production Environment Configuration Template
# ==============================================================================

# Server Environment Mode
NODE_ENV=production

# Application Port
PORT=3001

# Database Connection URL
# ------------------------------------------------------------------------------
# Option A: Production PostgreSQL (Recommended for Cloud / Render / Railway / AWS / Docker)
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/skilltrack_db?schema=public"
#
# Option B: Local / Containerized SQLite (Zero-dependency local demo)
DATABASE_URL="file:./dev.db"

# JSON Web Token Cryptographic Secret
# Generate a strong 64-character secret in production using: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_production_jwt_secret_key_minimum_32_characters

# CORS Allowed Origins
# Comma-separated list of allowed frontend domains, or '*' to allow any origin
# Example: CORS_ORIGIN="https://skilltrack.gov.in,https://app.skilltrack.gov.in"
CORS_ORIGIN=*

# Optional External Integrations (Simulated by default - no credentials required for demo)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GUPSHUP_API_KEY=
